{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpectaCLI",
  "version": "0.1.0",
  "identifier": "dev.spectacli.app",
  "build": {
    "beforeDevCommand": "npm run notify && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run notify -- --release && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SpectaCLI",
        "decorations": false,
        "width": 1200,
        "height": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/spectacli-notify"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
